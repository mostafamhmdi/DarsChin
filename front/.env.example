# آدرس core (FastAPI). پروکسیِ Vite مسیر /api را به این آدرس می‌فرستد.
# core را این‌طور اجرا کنید:   cd core && uvicorn core.api:app --port 8000
CORE_URL=http://127.0.0.1:8000

# فقط اگر نمی‌خواهید از پروکسی استفاده کنید (مثلاً فرانت و core روی دو سرور جدا هستند)
# آدرس کامل endpoint حل را بدهید؛ در این حالت core باید CORS را مجاز کند.
# VITE_API_URL=https://example.com/v1/schedule/solve
